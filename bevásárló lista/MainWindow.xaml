<Window x:Class="bevásárló_lista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bevásárló_lista"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFDACDFF">
        <TextBox x:Name="ItemBox" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="219" Height="41" BorderThickness="1,1,6,6" BorderBrush="#FF092B92"/>
        <Button Content="Hozzáadás" x:Name="Ghozzaadas" HorizontalAlignment="Left" Margin="248,10,0,0" VerticalAlignment="Top" Height="41" Width="152" Click="Ghozzaadas_Click" BorderBrush="Black" BorderThickness="1,1,6,6">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FF6AE83F" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <ListBox x:Name="Blista" Margin="10,88,400,10" BorderThickness="1,1,6,6" BorderBrush="#FF05206F">
            <ListBox.Background>
                <SolidColorBrush Color="Black" Opacity="0.2"/>
            </ListBox.Background>
        </ListBox>
        <Button x:Name="Btorol" Content="Tőrlés" HorizontalAlignment="Left" Margin="405,10,0,0" VerticalAlignment="Top" Height="40" Width="152" Click="Torles" BorderBrush="Black" BorderThickness="1,1,6,6">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFEF0808" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="BtorolMinden" Content="Minden tőrlése" HorizontalAlignment="Left" Margin="562,10,0,0" VerticalAlignment="Top" Height="40" Width="151" Click="MindenTorol" BorderBrush="Black" BorderThickness="1,1,6,6">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF790C0C"/>
                    <GradientStop Color="#FFF31515" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Label x:Name="Label1" Content="Termékek Száma" HorizontalAlignment="Left" Margin="418,88,0,0" VerticalAlignment="Top" Height="40" Width="220" BorderThickness="0,0,6,6" BorderBrush="Black"/>
    </Grid>
</Window>
